  <script>
(() => {
  'use strict';

  const LIMIT_MONTH = 240;
  const LIMIT_START = 999;
  const MAX_ADULT_PICTURES = 24;
  const MAX_BABY_PICTURES = 24;
  const formatter = new Intl.NumberFormat('ko-KR');
  const byId = id => document.getElementById(id);
  const fields = { adults: byId('initialAdults'), babies: byId('initialBabies'), month: byId('targetMonth') };
  const state = { adults: 1, babies: 0, month: 6, selectedId: null, treeView: 'forest', forestPage: 0, treeMode: 'adult', treeFocusId: 1n, treeDepth: 6, treeFit: false, playing: false, timer: null };
  let records = [];
  let lastTreeViewKey = '';
  let forestOffsets = {};

  const fmt = n => formatter.format(n);
  const safeInt = (value, min, max, fallback) => {
    const number = Number(value);
    if (!Number.isFinite(number)) return fallback;
    return Math.max(min, Math.min(max, Math.trunc(number)));
  };

  // Open the same self-contained HTML in a tree-only window. No second file is needed.
  const popupParams = new URLSearchParams(window.location.search);
  const isTreePopup = popupParams.get('rabbitTreePopup') === '1';
  if (isTreePopup) {
    if (popupParams.has('adults')) state.adults = safeInt(popupParams.get('adults'), 0, LIMIT_START, state.adults);
    if (popupParams.has('babies')) state.babies = safeInt(popupParams.get('babies'), 0, LIMIT_START, state.babies);
    if (popupParams.has('month')) state.month = safeInt(popupParams.get('month'), 0, LIMIT_MONTH, state.month);
    if (popupParams.has('depth')) state.treeDepth = safeInt(popupParams.get('depth'), 2, 6, state.treeDepth);
    if (popupParams.has('page')) state.forestPage = safeInt(popupParams.get('page'), 0, LIMIT_START, 0);
    const popupView = popupParams.get('view');
    state.treeView = ['forest', 'focus', 'single-adult', 'single-baby'].includes(popupView) ? popupView : 'forest';
    state.treeMode = popupParams.get('mode') === 'baby' ? 'baby' : 'adult';
    const focusId = popupParams.get('focusId') || '';
    if (/^\d{1,110}$/.test(focusId)) state.treeFocusId = BigInt(focusId);
    document.body.classList.add('tree-popup');
    document.title = '수형도 크게 보기 — 피보나치 토끼 실험실';
    byId('treePopupBanner').hidden = false;
    byId('treePopupBtn').hidden = true;
    byId('treeViewHint').textContent = '↔ 수형도를 옆으로 스크롤하거나, 전체 보기로 한눈에 살펴보세요.';
  }

  function openTreePopup() {
    const url = new URL(window.location.href);
    const settings = {
      rabbitTreePopup: '1', adults: state.adults, babies: state.babies,
      month: state.month, depth: state.treeDepth, page: state.forestPage,
      view: state.treeView, mode: state.treeMode, focusId: state.treeFocusId.toString()
    };
    for (const [name, value] of Object.entries(settings)) url.searchParams.set(name, String(value));
    const popup = window.open(url.href, '_blank', 'popup=yes,width=1500,height=950,resizable=yes,scrollbars=yes');
    if (popup) {
      popup.opener = null;
      byId('treePopupNotice').hidden = true;
    } else {
      byId('treePopupNotice').hidden = false;
      byId('treePopupNotice').textContent = '새 창이 차단되었어요. 브라우저에서 팝업을 허용한 뒤 다시 눌러 주세요.';
    }
  }

  function calculateRecords() {
    const list = [{ month: 0, adults: BigInt(state.adults), babies: BigInt(state.babies) }];
    for (let m = 1; m <= state.month; m++) {
      const prev = list[m - 1];
      list.push({ month: m, adults: prev.adults + prev.babies, babies: prev.adults });
    }
    return list;
  }

  // The one-rabbit examples have their own population and numbering, independent
  // of the user's full experiment. Both start with rabbit #1 at month zero.
  function singleRabbitRecordAt(kind, month) {
    let adults = kind === 'adult' ? 1n : 0n;
    let babies = kind === 'baby' ? 1n : 0n;
    for (let m = 0; m < month; m++) {
      const nextAdults = adults + babies;
      babies = adults;
      adults = nextAdults;
    }
    return { month, adults, babies };
  }

  const totalOf = record => record.adults + record.babies;
  const tag = id => `#${fmt(id)}`;
  const shortTag = id => {
    const digits = id.toString();
    return digits.length <= 9 ? tag(id) : `#${digits.slice(0, 3)}…${digits.slice(-3)}`;
  };

  // IDs are permanent. Adults are #1..#A; babies are #(A+1)..#(A+B).
  // Each previous adult #i gives birth to baby #(previousTotal+i).
  // Each previous baby keeps its ID when it becomes an adult.
  function displayIds(first, count, max) {
    const limit = BigInt(max);
    if (count <= limit) return Array.from({ length: Number(count) }, (_, i) => first + BigInt(i));
    const half = Math.floor(max / 2);
    const begin = Array.from({ length: half }, (_, i) => first + BigInt(i));
    const end = Array.from({ length: max - half }, (_, i) => first + count - BigInt(max - half) + BigInt(i));
    return [...begin, null, ...end];
  }

  function relatedId() {
    if (state.selectedId === null || state.month === 0) return null;
    const current = records[state.month];
    const prev = records[state.month - 1];
    const id = state.selectedId;
    if (id > current.adults) return id - totalOf(prev); // current baby -> previous adult parent
    if (id <= prev.adults) return totalOf(prev) + id; // enduring adult -> newborn child
    return null; // a baby that has just matured
  }

  function selectRabbit(id) {
    state.selectedId = id;
    byId('rabbitLookup').value = id.toString();
    byId('lookupMessage').textContent = '';
    const current = records[state.month];
    renderGarden('adultGarden', 'adult', current.adults, MAX_ADULT_PICTURES, 1n);
    renderGarden('babyGarden', 'baby', current.babies, MAX_BABY_PICTURES, current.adults + 1n);
    renderLineage();
    focusTreeOnRabbit(id);
  }

  function renderGarden(id, type, count, max, firstId) {
    const container = byId(id);
    container.replaceChildren();
    const fragment = document.createDocumentFragment();
    const visible = displayIds(firstId, count, max);
    const related = relatedId();
    visible.forEach((rabbitId, i) => {
      if (rabbitId === null) {
        const extra = document.createElement('span');
        extra.className = `rabbit-more ${type === 'baby' ? 'baby-more' : ''}`;
        extra.textContent = `중간 ${fmt(count - BigInt(max))}마리 생략`;
        fragment.appendChild(extra);
        return;
      }
      const bunny = document.createElement('button');
      bunny.type = 'button';
      bunny.className = `rabbit-token ${type}`;
      if (rabbitId === state.selectedId) bunny.classList.add('is-selected');
      else if (rabbitId === related) bunny.classList.add('is-related');
      bunny.style.setProperty('--delay', `${Math.min(i * 13, 250)}ms`);
      bunny.setAttribute('aria-pressed', String(rabbitId === state.selectedId));
      bunny.setAttribute('aria-label', `${type === 'adult' ? '어른' : '새끼'} 토끼 ${tag(rabbitId)}. 이 토끼의 관계 보기`);
      bunny.title = `${type === 'adult' ? '어른' : '새끼'} 토끼 ${tag(rabbitId)}`;
      bunny.innerHTML = `<svg viewBox="0 0 88 100" aria-hidden="true"><use href="#rabbit-${type}"></use></svg><span class="rabbit-id" title="${tag(rabbitId)}">${shortTag(rabbitId)}</span>`;
      bunny.addEventListener('click', () => selectRabbit(rabbitId));
      fragment.appendChild(bunny);
    });
    if (count === 0n) {
      const empty = document.createElement('span');
      empty.className = 'rabbit-more';
      empty.textContent = '아직 토끼가 없어요';
      fragment.appendChild(empty);
    }
    container.appendChild(fragment);
  }

  function samplePairs(start, count, selected, limit = 4) {
    if (count <= BigInt(limit)) return displayIds(start, count, limit);
    const picks = [start, start + 1n, start + count - 1n];
    if (selected !== null && selected >= start && selected < start + count) picks.push(selected);
    else picks.push(start + 2n);
    return [...new Set(picks)].sort((a, b) => a < b ? -1 : a > b ? 1 : 0);
  }

  function makeTraceChip(type, phase, id) {
    const chip = document.createElement('div');
    chip.className = `trace-chip ${type}`;
    chip.title = tag(id);
    chip.innerHTML = `<svg viewBox="0 0 88 100" aria-hidden="true"><use href="#rabbit-${type}"></use></svg><span class="trace-name">${phase} ${type === 'adult' ? '어른' : '새끼'}</span><span class="trace-id">${shortTag(id)}</span>`;
    return chip;
  }

  function makeTracePair(kind, before, after, focused) {
    const pair = document.createElement('div');
    pair.className = 'trace-pair';
    if (focused) pair.classList.add('is-highlighted');
    const grown = kind === 'grow';
    pair.appendChild(makeTraceChip(grown ? 'baby' : 'adult', '지난달', before));
    const arrow = document.createElement('div');
    arrow.className = 'trace-arrow';
    arrow.innerHTML = `<strong>→</strong><span>${grown ? '성장' : '출산'}</span>`;
    pair.appendChild(arrow);
    pair.appendChild(makeTraceChip(grown ? 'adult' : 'baby', '이번 달', after));
    return pair;
  }

  function birthInformation(id) {
    const firstTotal = totalOf(records[0]);
    if (id <= firstTotal) return '처음부터 마을에 있던 토끼예요.';
    for (let month = 1; month < records.length; month++) {
      if (id <= totalOf(records[month])) {
        const parent = id - totalOf(records[month - 1]);
        return `${month}개월째에 어른 ${tag(parent)}에게서 태어났어요.`;
      }
    }
    return '';
  }

  function renderLineage() {
    const month = state.month;
    const current = records[month];
    const details = byId('selectedTrace');
    byId('lineageMonth').textContent = month === 0 ? '시작 시점' : `${month - 1} → ${month}개월`;
    const growthList = byId('growthPairs');
    const birthList = byId('birthPairs');
    growthList.replaceChildren();
    birthList.replaceChildren();

    if (state.selectedId !== null && state.selectedId <= totalOf(current)) {
      const id = state.selectedId;
      const isBaby = id > current.adults;
      let change = '';
      if (month === 0) {
        change = '지금은 시작 시점이라 지난달의 변화는 없어요.';
      } else {
        const prev = records[month - 1];
        if (isBaby) change = `이번 달 새끼 ${tag(id)}의 부모는 지난달 어른 ${tag(id - totalOf(prev))}예요.`;
        else if (id > prev.adults) change = `지난달 새끼 ${tag(id)} → 이번 달 어른 ${tag(id)}! 같은 토끼이므로 번호는 그대로예요.`;
        else change = `지난달에도 어른이었고 지금도 살아 있어요. 이번 달 새끼 ${tag(totalOf(prev) + id)}를 낳았어요.`;
      }
      details.className = 'selected-trace has-selection';
      details.replaceChildren();
      const heading = document.createElement('div');
      heading.className = 'selection-title';
      const name = document.createElement('strong');
      name.textContent = `${isBaby ? '새끼' : '어른'} 토끼 ${tag(id)}`;
      const type = document.createElement('span');
      type.className = 'selection-type';
      type.textContent = '선택한 토끼';
      heading.append(name, type);
      const info = document.createElement('p');
      info.textContent = birthInformation(id);
      const story = document.createElement('p');
      story.textContent = change;
      details.append(heading, info, story);
    } else {
      details.className = 'selected-trace';
      details.innerHTML = '<span class="trace-hand">☝️</span> 위 토끼 그림을 누르거나 번호를 입력해 보세요.';
    }

    if (month === 0) {
      byId('lineageIntro').textContent = '시작 시점이에요. 한 달 더하기를 누르면 누가 성장하고 누가 태어났는지 볼 수 있어요.';
      byId('growthPairCount').textContent = '0쌍';
      byId('birthPairCount').textContent = '0쌍';
      for (const target of [growthList, birthList]) {
        const empty = document.createElement('div');
        empty.className = 'trace-empty';
        empty.textContent = '아직 이전 달이 없어요';
        target.appendChild(empty);
      }
      return;
    }

    byId('lineageIntro').textContent = '지난달과 이번 달을 연결했어요. 같은 번호는 같은 토끼! 그림이나 번호를 눌러 관계를 찾아보세요.';
    const prev = records[month - 1];
    const previousTotal = totalOf(prev);
    byId('growthPairCount').textContent = `${fmt(prev.babies)}쌍`;
    byId('birthPairCount').textContent = `${fmt(prev.adults)}쌍`;
    let selectedGrow = null;
    let selectedParent = null;
    if (state.selectedId !== null) {
      if (state.selectedId > prev.adults && state.selectedId <= previousTotal) selectedGrow = state.selectedId;
      if (state.selectedId <= prev.adults) selectedParent = state.selectedId;
      else if (state.selectedId > previousTotal && state.selectedId <= totalOf(current)) selectedParent = state.selectedId - previousTotal;
    }
    const growIds = samplePairs(prev.adults + 1n, prev.babies, selectedGrow);
    const parentIds = samplePairs(1n, prev.adults, selectedParent);
    growIds.forEach(id => growthList.appendChild(makeTracePair('grow', id, id, id === selectedGrow)));
    parentIds.forEach(id => birthList.appendChild(makeTracePair('birth', id, previousTotal + id, id === selectedParent)));
    if (prev.babies === 0n) {
      const empty = document.createElement('div'); empty.className = 'trace-empty'; empty.textContent = '성장할 새끼가 없어요'; growthList.appendChild(empty);
    } else if (prev.babies > BigInt(growIds.length)) {
      const note = document.createElement('div'); note.className = 'trace-more'; note.textContent = `외 ${fmt(prev.babies - BigInt(growIds.length))}쌍 더 있어요`; growthList.appendChild(note);
    }
    if (prev.adults === 0n) {
      const empty = document.createElement('div'); empty.className = 'trace-empty'; empty.textContent = '출산할 어른이 없어요'; birthList.appendChild(empty);
    } else if (prev.adults > BigInt(parentIds.length)) {
      const note = document.createElement('div'); note.className = 'trace-more'; note.textContent = `외 ${fmt(prev.adults - BigInt(parentIds.length))}쌍 더 있어요`; birthList.appendChild(note);
    }
  }

  const svgEl = (name, attrs = {}, contents = '') => {
    const el = document.createElementNS('http://www.w3.org/2000/svg', name);
    for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));
    if (contents) el.textContent = contents;
    return el;
  };

  function recordAt(month) {
    if (month < records.length) return records[month];
    let result = records[records.length - 1];
    for (let step = records.length; step <= month; step++) {
      result = { month: step, adults: result.adults + result.babies, babies: result.adults };
    }
    return result;
  }

  function treeSource() {
    return recordAt(Math.max(0, state.month - 1));
  }

  function treeRange() {
    const root = treeSource();
    return state.treeMode === 'adult'
      ? { first: 1n, last: root.adults, count: root.adults }
      : { first: root.adults + 1n, last: totalOf(root), count: root.babies };
  }

  function normalizeTreeFocus() {
    const root = treeSource();
    if (state.treeMode === 'adult' && root.adults === 0n && root.babies > 0n) state.treeMode = 'baby';
    if (state.treeMode === 'baby' && root.babies === 0n && root.adults > 0n) state.treeMode = 'adult';
    const range = treeRange();
    if (range.count === 0n) { state.treeFocusId = 0n; return; }
    if (state.treeFocusId < range.first || state.treeFocusId > range.last) state.treeFocusId = range.first;
  }

  function focusTreeOnRabbit(id) {
    state.treeView = 'focus';
    const current = records[state.month];
    if (state.month === 0) {
      state.treeMode = id <= current.adults ? 'adult' : 'baby';
      state.treeFocusId = id;
    } else {
      const prev = records[state.month - 1];
      if (id > current.adults) {
        state.treeMode = 'adult';
        state.treeFocusId = id - totalOf(prev);
      } else if (id > prev.adults) {
        state.treeMode = 'baby';
        state.treeFocusId = id;
      } else {
        state.treeMode = 'adult';
        state.treeFocusId = id;
      }
    }
    renderTree();
  }

  function drawTreeNode(svg, x, y, kind, id, caption, detail, month) {
    const group = svgEl('g', { class: `tree-svg-node ${kind}`, 'data-id': id.toString(), 'data-month': month, 'data-kind': kind });
    const isSelected = id === state.selectedId && month === state.month;
    group.appendChild(svgEl('rect', { x: x - 61, y: y - 34, width: 122, height: 68, rx: 13, class: `tree-svg-card ${kind}${isSelected ? ' is-selected' : ''}` }));
    group.appendChild(svgEl('use', { href: `#rabbit-${kind}`, x: x - 55, y: y - 26, width: 44, height: 50 }));
    group.appendChild(svgEl('text', { x: x - 7, y: y - 17, class: 'tree-svg-caption' }, `${caption} · ${month}개월`));
    group.appendChild(svgEl('text', { x: x - 7, y: y + 2, class: `tree-svg-id ${kind}` }, shortTag(id)));
    group.appendChild(svgEl('text', { x: x - 7, y: y + 19, class: 'tree-svg-desc' }, detail));
    group.appendChild(svgEl('title', {}, `${month}개월 ${kind === 'adult' ? '어른' : '새끼'} 토끼 ${tag(id)}. ${detail}`));
    svg.appendChild(group);
  }

  function drawTreeLink(svg, fromX, fromY, toX, toY, kind) {
    const startY = fromY + 34;
    const endY = toY - 34;
    const curvature = Math.max(15, (endY - startY) * .48);
    const path = `M${fromX} ${startY} C${fromX} ${startY + curvature},${toX} ${endY - curvature},${toX} ${endY}`;
    svg.appendChild(svgEl('path', { d: path, class: `tree-svg-link ${kind}` }));
    svg.appendChild(svgEl('text', { x: (fromX + toX) / 2, y: (startY + endY) / 2 - 8, class: `tree-svg-link-label ${kind}` }, { alive: '생존', birth: '출산', grow: '성장' }[kind]));
  }

  // The tree contains every offspring of ONE focused rabbit, not a sample.
  // Each adult has two edges (survival and a uniquely numbered newborn).
  // Each baby has one edge (maturation with the same permanent ID).
  function buildRabbitBranch(id, kind, layer, depth, rootMonth, incoming = 'root', populationAt = recordAt) {
    const node = { id, kind, layer, incoming, children: [], x: 0, y: 0 };
    if (layer < depth) {
      if (kind === 'adult') {
        node.children.push(buildRabbitBranch(id, 'adult', layer + 1, depth, rootMonth, 'alive', populationAt));
        const childId = totalOf(populationAt(rootMonth + layer)) + id;
        node.children.push(buildRabbitBranch(childId, 'baby', layer + 1, depth, rootMonth, 'birth', populationAt));
      } else {
        node.children.push(buildRabbitBranch(id, 'adult', layer + 1, depth, rootMonth, 'grow', populationAt));
      }
    }
    return node;
  }

  function initialForestPageCount() {
    return Math.max(1, Math.ceil(state.adults / 2), Math.ceil(state.babies / 2));
  }

  function visibleInitialRabbits() {
    const start = state.forestPage * 2;
    const roots = [];
    // The supplied teaching example shows babies first, then adults.
    for (let i = start; i < Math.min(state.babies, start + 2); i++) roots.push({ id: BigInt(state.adults + i + 1), kind: 'baby' });
    for (let i = start; i < Math.min(state.adults, start + 2); i++) roots.push({ id: BigInt(i + 1), kind: 'adult' });
    return roots;
  }

  // A fixed side rail shows the WHOLE population for each month, regardless
  // of which initial rabbits are visible on this forest page.
  function renderMonthRail(firstMonth, depth, firstY, stepY, height, diagramWidth, populationAt = recordAt) {
    const rail = byId('treeMonthRail');
    const frame = byId('treeFrame');
    rail.replaceChildren();
    rail.classList.toggle('is-fit', state.treeFit);
    const scale = state.treeFit ? (frame.clientWidth || diagramWidth) / diagramWidth : 1;
    rail.style.height = `${height * scale}px`;
    const heading = document.createElement('div');
    heading.className = 'tree-rail-heading';
    heading.textContent = '월별 전체 토끼 수';
    rail.appendChild(heading);

    for (let layer = 0; layer <= depth; layer++) {
      const month = firstMonth + layer;
      const record = populationAt(month);
      const total = totalOf(record);
      const item = document.createElement('div');
      item.className = `tree-rail-item${month === state.month ? ' is-current' : ''}${state.treeFit ? ' is-compact' : ''}`;
      item.style.top = `${(firstY + layer * stepY) * scale}px`;
      item.title = `${month}개월: 전체 ${fmt(total)}마리 (어른 ${fmt(record.adults)}마리, 새끼 ${fmt(record.babies)}마리)`;
      item.setAttribute('aria-label', item.title);
      const label = document.createElement('span');
      label.className = 'tree-rail-month';
      label.textContent = `${month}개월`;
      const count = document.createElement('strong');
      count.textContent = `${fmt(total)}마리`;
      const detail = document.createElement('small');
      detail.textContent = `어른 ${fmt(record.adults)} · 새끼 ${fmt(record.babies)}`;
      item.append(label, count, detail);
      rail.appendChild(item);
    }
  }

  function renderForest() {
    const svg = byId('rabbitTree');
    const frame = byId('treeFrame');
    svg.replaceChildren();
    forestOffsets = {};
    const depth = state.treeDepth;
    const sampleKind = state.treeView === 'single-adult' ? 'adult' : state.treeView === 'single-baby' ? 'baby' : null;
    const populationAt = sampleKind ? month => singleRabbitRecordAt(sampleKind, month) : recordAt;
    const roots = sampleKind ? [{ id: 1n, kind: sampleKind }] : visibleInitialRabbits();
    if (!roots.length) {
      const emptyHeight = 252 + depth * 115;
      svg.setAttribute('viewBox', `0 0 900 ${emptyHeight}`);
      svg.style.width = '900px';
      svg.appendChild(svgEl('text', { x: 450, y: emptyHeight / 2, class: 'tree-svg-fallback' }, '처음 토끼가 없어요. 위에서 초기 마릿수를 설정해 주세요!'));
      renderMonthRail(0, depth, 164, 115, emptyHeight, 900, populationAt);
      byId('treeExplanation').textContent = '어른 0마리, 새끼 0마리에서 시작하면 이후에도 토끼가 생기지 않아요.';
      lastTreeViewKey = '';
      return;
    }

    const groups = [];
    const allRows = Array.from({ length: depth + 1 }, () => []);
    let cursor = 172;
    for (const root of roots) {
      const node = buildRabbitBranch(root.id, root.kind, 0, depth, 0, 'root', populationAt);
      let leaves = 0;
      function place(branch, parent = null) {
        branch.parent = parent;
        branch.y = 164 + branch.layer * 115;
        allRows[branch.layer].push(branch);
        if (branch.children.length) {
          for (const child of branch.children) place(child, branch);
          branch.x = (branch.children[0].x + branch.children.at(-1).x) / 2;
        } else {
          branch.x = cursor + leaves * 70;
          leaves++;
        }
      }
      place(node);
      const left = cursor - 34;
      const right = cursor + (leaves - 1) * 70 + 34;
      groups.push({ node, left, right });
      cursor = right + 85;
    }
    const width = Math.max(920, cursor + 30);
    const height = 252 + depth * 115;
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.style.width = `${width}px`;
    renderMonthRail(0, depth, 164, 115, height, width, populationAt);

    const defs = svgEl('defs');
    const marker = svgEl('marker', { id: 'forestArrow', viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 5, markerHeight: 5, orient: 'auto-start-reverse' });
    marker.appendChild(svgEl('path', { d: 'M 1 1 L 9 5 L 1 9 z', fill: '#adb6b1' }));
    defs.appendChild(marker);
    svg.appendChild(defs);

    for (const { node, left, right } of groups) {
      if (forestOffsets[node.kind] === undefined) forestOffsets[node.kind] = left;
      svg.appendChild(svgEl('rect', { x: left, y: 12, width: right - left, height: height - 38, rx: 18, class: `forest-root-band ${node.kind}` }));
      svg.appendChild(svgEl('text', { x: node.x, y: 35, 'text-anchor': 'middle', class: `forest-root-label ${node.kind}` }, `처음 ${node.kind === 'adult' ? '어른' : '새끼'} ${tag(node.id)}`));
      svg.appendChild(svgEl('use', { href: `#rabbit-${node.kind}`, x: node.x - 31, y: 52, width: 62, height: 72 }));
    }
    for (let layer = 0; layer <= depth; layer++) {
      const y = 164 + layer * 115;
      if (layer === state.month) svg.appendChild(svgEl('rect', { x: 10, y: y - 22, width: width - 20, height: 44, rx: 12, class: 'forest-current-row' }));
      svg.appendChild(svgEl('text', { x: 20, y: y - 7, class: `forest-month-label${layer === state.month ? ' current' : ''}` }, `${layer}개월`));
      if (layer === 0) svg.appendChild(svgEl('text', { x: 20, y: y + 13, class: 'forest-month-note' }, '시작'));
    }

    for (const row of allRows.slice(0, -1)) {
      for (const node of row) {
        for (const child of node.children) {
          const y1 = node.y + 17, y2 = child.y - 18;
          const dy = (y2 - y1) * .52;
          const path = `M${node.x} ${y1} C${node.x} ${y1 + dy},${child.x} ${y2 - dy},${child.x} ${y2}`;
          svg.appendChild(svgEl('path', { d: path, class: `forest-arrow ${child.incoming}`, 'marker-end': 'url(#forestArrow)' }));
        }
      }
    }
    for (const row of allRows) {
      for (const node of row) {
        const group = svgEl('g', { class: 'forest-dot-group', 'data-id': node.id.toString(), 'data-month': node.layer, 'data-kind': node.kind });
        group.appendChild(svgEl('circle', { cx: node.x, cy: node.y, r: 15, class: `forest-dot ${node.kind}${node.layer === state.month && node.id === state.selectedId ? ' is-selected' : ''}` }));
        group.appendChild(svgEl('text', { x: node.x, y: node.y + 29, class: 'forest-dot-id', 'text-anchor': 'middle' }, shortTag(node.id)));
        const detail = node.incoming === 'root' ? '처음부터 있던 토끼'
          : node.incoming === 'birth' ? `어른 ${tag(node.parent.id)}가 낳은 새끼`
          : node.incoming === 'grow' ? `새끼 ${tag(node.id)}가 번호를 유지하며 성장`
          : `어른 ${tag(node.id)}가 계속 생존`;
        group.appendChild(svgEl('title', {}, `${node.layer}개월 ${node.kind === 'adult' ? '어른' : '새끼'} ${tag(node.id)} · ${detail}`));
        svg.appendChild(group);
      }
    }

    const visibleAdults = allRows[depth].filter(node => node.kind === 'adult').length;
    const visibleBabies = allRows[depth].length - visibleAdults;
    const outOfRange = state.month > depth ? `현재 선택한 ${state.month}개월은 그림의 0~${depth}개월 범위 밖이에요. ` : '';
    byId('treeExplanation').textContent = sampleKind
      ? `비교 예시: 0개월에 ${sampleKind === 'adult' ? '어른' : '새끼'} 토끼 #1 한 마리에서 시작했어요. ${depth}개월 뒤 어른 ${visibleAdults}마리, 새끼 ${visibleBabies}마리로 늘어납니다. 흰 원(○)은 어른, 주황 원(●)은 새끼예요. 같은 번호는 성장해도 같은 토끼이고, 출산한 어른은 계속 살아 있어요. ${outOfRange}왼쪽 합계도 이 한 마리의 자손만 센 값입니다.`
      : `0개월의 출발 토끼 ${roots.length}마리에서 각각 뻗은 가지예요. ${depth}개월 뒤 이 그림에 그려진 토끼는 어른 ${visibleAdults}마리, 새끼 ${visibleBabies}마리입니다. 흰 원(○)은 어른, 주황 원(●)은 새끼이며, 같은 번호는 성장해도 같은 토끼예요. ${outOfRange}전체 초기 토끼는 위의 숫자와 번호 범위에서 확인하세요.`;
    const viewKey = `${state.treeView}:${state.forestPage}:${depth}:${state.treeFit}:${state.adults}:${state.babies}`;
    if (viewKey !== lastTreeViewKey) {
      frame.scrollLeft = 0;
      lastTreeViewKey = viewKey;
    }
  }

  function renderTree() {
    const initialAdults = BigInt(state.adults);
    const initialBabies = BigInt(state.babies);
    byId('forestAdultCount').textContent = `${fmt(initialAdults)}마리`;
    byId('forestBabyCount').textContent = `${fmt(initialBabies)}마리`;
    const initialRange = (first, count) => count === 0n ? '처음 토끼 없음' : count === 1n ? tag(first) : `${tag(first)} ~ ${tag(first + count - 1n)}`;
    byId('forestAdultRange').textContent = `번호 ${initialRange(1n, initialAdults)}`;
    byId('forestBabyRange').textContent = `번호 ${initialRange(initialAdults + 1n, initialBabies)}`;
    byId('forestJumpAdult').disabled = initialAdults === 0n;
    byId('forestJumpBaby').disabled = initialBabies === 0n;

    const isForest = state.treeView === 'forest';
    const isFocus = state.treeView === 'focus';
    const isSample = state.treeView === 'single-adult' || state.treeView === 'single-baby';
    byId('forestHeading').closest('.forest-card').classList.toggle('is-single-sample', isSample);
    for (const [mode, buttonId] of [['forest', 'forestModeAll'], ['single-adult', 'forestModeSingleAdult'], ['single-baby', 'forestModeSingleBaby'], ['focus', 'forestModeFocus']]) {
      const active = state.treeView === mode;
      const button = byId(buttonId);
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    }
    const focusToolbar = byId('forestFocusToolbar');
    focusToolbar.hidden = !isFocus;
    byId('forestPages').hidden = !isForest;
    byId('forestPageDetail').hidden = isFocus;
    byId('forestPageDetail').classList.toggle('is-sample', isSample);
    const pages = initialForestPageCount();
    state.forestPage = Math.min(state.forestPage, pages - 1);
    const visibleRoots = visibleInitialRabbits();
    byId('forestPageLabel').textContent = `출발 토끼 묶음 ${state.forestPage + 1} / ${pages}`;
    byId('forestPrev').disabled = state.forestPage === 0;
    byId('forestNext').disabled = state.forestPage >= pages - 1;
    byId('forestPageDetail').textContent = isSample
      ? `🌱 한 마리 비교 예시 · 0개월에 ${state.treeView === 'single-adult' ? '어른' : '새끼'} 토끼 #1 한 마리만 있는 경우예요. 위 실험 설정과 별개이며, 월별 합계도 이 토끼 한 마리에서 시작해 계산해요.`
      : `이번 그림: ${visibleRoots.length ? visibleRoots.map(root => `${root.kind === 'adult' ? '어른' : '새끼'} ${tag(root.id)}`).join(' · ') : '없음'} · 전체 처음 토끼는 ${fmt(initialAdults + initialBabies)}마리예요. 많을 때는 ‹ ›로 다른 출발 토끼를 확인하세요.`;
    for (const button of document.querySelectorAll('[data-tree-depth]')) {
      const active = Number(button.dataset.treeDepth) === state.treeDepth;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    }
    byId('treeFrame').classList.toggle('is-fit', state.treeFit);
    byId('treeFitBtn').textContent = state.treeFit ? '큰 그림 보기' : '전체 보기';
    byId('treeFitBtn').setAttribute('aria-pressed', String(state.treeFit));
    if (isFocus) renderFocusTree();
    else renderForest();
  }

  function renderFocusTree() {
    normalizeTreeFocus();
    const svg = byId('rabbitTree');
    svg.replaceChildren();
    const rootMonth = Math.max(0, state.month - 1);
    const root = recordAt(rootMonth);
    const id = state.treeFocusId;
    const hasAdults = root.adults > 0n;
    const hasBabies = root.babies > 0n;

    for (const [mode, buttonId, available] of [['adult', 'treeModeAdult', hasAdults], ['baby', 'treeModeBaby', hasBabies]]) {
      const button = byId(buttonId);
      button.disabled = !available;
      button.classList.toggle('is-active', state.treeMode === mode);
      button.setAttribute('aria-pressed', String(state.treeMode === mode));
    }
    const range = treeRange();
    byId('treeFocusPrev').disabled = id <= range.first;
    byId('treeFocusNext').disabled = id >= range.last;
    byId('treeFocusLabel').textContent = range.count ? `${state.treeMode === 'adult' ? '어른' : '새끼'} ${shortTag(id)}` : '토끼 없음';
    byId('treeFocusLabel').title = range.count ? tag(id) : '';

    for (const button of document.querySelectorAll('[data-tree-depth]')) {
      const active = Number(button.dataset.treeDepth) === state.treeDepth;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    }
    const frame = byId('treeFrame');
    frame.classList.toggle('is-fit', state.treeFit);
    byId('treeFitBtn').textContent = state.treeFit ? '큰 그림 보기' : '전체 보기';
    byId('treeFitBtn').setAttribute('aria-pressed', String(state.treeFit));

    if (range.count === 0n) {
      lastTreeViewKey = '';
      const emptyHeight = 190 + state.treeDepth * 151;
      svg.setAttribute('viewBox', `0 0 820 ${emptyHeight}`);
      svg.style.width = '820px';
      svg.appendChild(svgEl('text', { x: 410, y: emptyHeight / 2, class: 'tree-svg-fallback' }, '시작할 토끼가 없어요. 초기 마릿수를 바꿔 보세요!'));
      renderMonthRail(rootMonth, state.treeDepth, 103, 151, emptyHeight, 820);
      byId('treeExplanation').textContent = '초기 어른과 새끼 수가 모두 0마리라면 새로운 토끼가 생기지 않아요.';
      return;
    }

    const depth = state.treeDepth;
    const origin = buildRabbitBranch(id, state.treeMode, 0, depth, rootMonth);
    const rows = Array.from({ length: depth + 1 }, () => []);
    let leafCount = 0;
    function place(node) {
      node.y = 103 + node.layer * 151;
      rows[node.layer].push(node);
      if (node.children.length) {
        node.children.forEach(child => place(child));
        node.x = (node.children[0].x + node.children.at(-1).x) / 2;
      } else {
        node.x = 136 + leafCount * 148;
        leafCount++;
      }
    }
    place(origin);
    const rawWidth = 272 + (leafCount - 1) * 148;
    const width = Math.max(820, rawWidth);
    const offset = (width - rawWidth) / 2;
    for (const row of rows) for (const node of row) node.x += offset;
    const height = 190 + depth * 151;
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.style.width = `${width}px`;
    renderMonthRail(rootMonth, depth, 103, 151, height, width);
    for (let layer = 0; layer <= depth; layer++) {
      const month = rootMonth + layer;
      const caption = month === state.month ? '현재' : month < state.month ? '이전' : '미래';
      const adults = rows[layer].filter(node => node.kind === 'adult').length;
      const babies = rows[layer].length - adults;
      const countText = `이 가지 어른 ${adults} · 새끼 ${babies}`;
      svg.appendChild(svgEl('text', { x: 23, y: 30 + layer * 151, class: `tree-svg-month${caption === '현재' ? ' tree-svg-month-current' : ''}` }, `${month}개월 · ${caption}`));
      svg.appendChild(svgEl('text', { x: 23, y: 49 + layer * 151, class: 'tree-svg-layer-count' }, countText));
      if (layer < depth) svg.appendChild(svgEl('line', { x1: 24, y1: 158 + layer * 151, x2: width - 24, y2: 158 + layer * 151, class: 'tree-svg-divider' }));
    }
    for (const row of rows.slice(0, -1)) {
      for (const node of row) for (const child of node.children) drawTreeLink(svg, node.x, node.y, child.x, child.y, child.incoming);
    }
    for (const row of rows) {
      for (const node of row) {
        const month = rootMonth + node.layer;
        const caption = month === state.month ? '현재' : month < state.month ? '이전' : '미래';
        const detail = { root: '출발 토끼', alive: '계속 생존', birth: '새끼 출생', grow: '어른으로 성장' }[node.incoming];
        drawTreeNode(svg, node.x, node.y, node.kind, node.id, caption, detail, month);
      }
    }
    const finalAdults = rows[depth].filter(node => node.kind === 'adult').length;
    const finalBabies = rows[depth].length - finalAdults;
    const initialChange = state.treeMode === 'adult'
      ? `첫 달에 새끼 ${tag(totalOf(root) + id)}를 낳고 본인은 계속 살아 있어요.`
      : `첫 달에는 토끼 ${tag(id)}가 번호를 유지한 채 어른으로 자라요.`;
    byId('treeExplanation').textContent = `${rootMonth}개월의 ${state.treeMode === 'adult' ? '어른' : '새끼'} 토끼 ${tag(id)}에서 출발! ${initialChange} ${depth}단계 뒤인 ${rootMonth + depth}개월에는 이 가지에 어른 ${finalAdults}마리와 새끼 ${finalBabies}마리가 있어요. 선을 따라가면 누가 자라고 누가 누구를 낳았는지 알 수 있어요.`;

    const viewKey = `${state.treeMode}:${id}:${depth}:${state.treeFit}`;
    if (viewKey !== lastTreeViewKey) {
      frame.scrollLeft = Math.max(0, (width - frame.clientWidth) / 2);
      lastTreeViewKey = viewKey;
    }
  }

  function renderChart() {
    const svg = byId('growthChart');
    svg.replaceChildren();
    const W = 480, H = 246, left = 55, right = 15, top = 17, bottom = 33;
    const cw = W - left - right, ch = H - top - bottom;
    const maxTotal = records.reduce((acc, r) => {
      const t = r.adults + r.babies;
      return t > acc ? t : acc;
    }, 0n);
    const maxY = Math.max(1, Number(maxTotal));
    const x = i => left + cw * (state.month === 0 ? .5 : i / state.month);
    const y = val => top + ch - (Number(val) / maxY) * ch;

    const defs = svgEl('defs');
    const gradient = svgEl('linearGradient', { id: 'adultArea', x1: '0', y1: '0', x2: '0', y2: '1' });
    gradient.append(svgEl('stop', { offset: '0%', 'stop-color': '#88b58f', 'stop-opacity': '.25' }), svgEl('stop', { offset: '100%', 'stop-color': '#88b58f', 'stop-opacity': '.01' }));
    defs.append(gradient);
    svg.append(defs);

    for (let i = 0; i <= 4; i++) {
      const value = maxY * (4 - i) / 4;
      const yy = top + ch * i / 4;
      svg.append(svgEl('line', { x1: left, y1: yy, x2: W - right, y2: yy, class: 'chart-grid' }));
      const label = value >= 100000 ? compactNumber(value) : fmt(Math.round(value));
      svg.append(svgEl('text', { x: left - 9, y: yy + 4, class: 'chart-axis-label', 'text-anchor': 'end' }, label));
    }

    const ticks = [...new Set([0, Math.round(state.month / 4), Math.round(state.month / 2), Math.round(state.month * 3 / 4), state.month])];
    ticks.forEach(t => svg.append(svgEl('text', { x: x(t), y: H - 7, class: 'chart-month-label', 'text-anchor': 'middle' }, `${t}개월`)));

    if (state.month === 0) {
      const one = records[0];
      svg.append(svgEl('circle', { cx: x(0), cy: y(one.adults), r: 6, fill: '#719f78', class: 'chart-last-circle' }));
      svg.append(svgEl('circle', { cx: x(0), cy: y(one.babies), r: 6, fill: '#e9a08b', class: 'chart-last-circle' }));
    } else {
      const ptsAdult = records.map((r, i) => [x(i), y(r.adults)]);
      const ptsBaby = records.map((r, i) => [x(i), y(r.babies)]);
      const pointsToPath = points => points.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(2)},${p[1].toFixed(2)}`).join(' ');
      const adultPath = pointsToPath(ptsAdult);
      const base = top + ch;
      const area = `${adultPath} L${x(state.month)},${base} L${x(0)},${base} Z`;
      svg.append(svgEl('path', { d: area, fill: 'url(#adultArea)' }));
      svg.append(svgEl('path', { d: adultPath, class: 'chart-line-adult' }));
      svg.append(svgEl('path', { d: pointsToPath(ptsBaby), class: 'chart-line-baby' }));
      svg.append(svgEl('circle', { cx: x(state.month), cy: ptsAdult.at(-1)[1], r: 5.7, fill: '#719f78', class: 'chart-last-circle' }));
      svg.append(svgEl('circle', { cx: x(state.month), cy: ptsBaby.at(-1)[1], r: 5.7, fill: '#e9a08b', class: 'chart-last-circle' }));
    }
    byId('chartCaption').textContent = `0개월부터 ${fmt(state.month)}개월까지의 변화`;
  }

  function compactNumber(num) {
    const abs = Math.abs(num);
    if (abs >= 1e12) return `${(num / 1e12).toPrecision(2)}조`;
    if (abs >= 1e8) return `${(num / 1e8).toPrecision(2)}억`;
    if (abs >= 1e4) return `${(num / 1e4).toPrecision(2)}만`;
    return fmt(Math.round(num));
  }

  function renderTable() {
    const body = byId('monthTable');
    const scroll = byId('tableScroll');
    body.replaceChildren();
    const fragment = document.createDocumentFragment();
    records.forEach(record => {
      const tr = document.createElement('tr');
      if (record.month === state.month) tr.className = 'is-current';
      tr.tabIndex = 0;
      tr.setAttribute('aria-label', `${record.month}개월로 이동`);
      const cells = [`${record.month}개월`, fmt(record.adults), fmt(record.babies), fmt(record.adults + record.babies)];
      cells.forEach(value => {
        const td = document.createElement('td');
        td.textContent = value;
        tr.appendChild(td);
      });
      tr.addEventListener('click', () => setMonth(record.month));
      tr.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); setMonth(record.month); }
      });
      fragment.appendChild(tr);
    });
    body.appendChild(fragment);
    // Keep the highlighted current month inside the table viewport.
    scroll.scrollTop = Math.max(0, scroll.scrollHeight - scroll.clientHeight);
  }

  function render() {
    records = calculateRecords();
    const current = records[state.month];
    const total = current.adults + current.babies;
    if (state.selectedId !== null && state.selectedId > total) {
      state.selectedId = null;
      byId('rabbitLookup').value = '';
    }
    byId('currentMonth').textContent = fmt(state.month);
    byId('gardenMonth').textContent = fmt(state.month);
    byId('adultCount').textContent = fmt(current.adults);
    byId('babyCount').textContent = fmt(current.babies);
    byId('totalCount').textContent = fmt(total);
    byId('adultGardenCount').textContent = `${fmt(current.adults)}마리`;
    byId('babyGardenCount').textContent = `${fmt(current.babies)}마리`;
    byId('prevMonth').disabled = state.month <= 0;
    byId('nextMonth').disabled = state.month >= LIMIT_MONTH;
    // Keep a field editable while the user clears or types a new number.
    if (document.activeElement !== fields.adults) fields.adults.value = state.adults;
    if (document.activeElement !== fields.babies) fields.babies.value = state.babies;
    if (document.activeElement !== fields.month) fields.month.value = state.month;

    renderGarden('adultGarden', 'adult', current.adults, MAX_ADULT_PICTURES, 1n);
    renderGarden('babyGarden', 'baby', current.babies, MAX_BABY_PICTURES, current.adults + 1n);
    const sampled = current.adults > BigInt(MAX_ADULT_PICTURES) || current.babies > BigInt(MAX_BABY_PICTURES);
    byId('gardenNotice').textContent = sampled
      ? '토끼가 많아서 종류별 앞·뒤 24마리만 표시했어요. 번호를 누르거나 아래에서 검색하면 관계를 추적할 수 있어요.'
      : '그림 하나가 실제 토끼 한 마리예요. 토끼 아래 번호를 눌러 성장과 출산 관계를 알아보세요.';
    if (state.month === 0) {
      byId('monthExplainer').textContent = `현재는 시작 시점이에요. 어른 ${fmt(current.adults)}마리, 새끼 ${fmt(current.babies)}마리에서 출발해요.`;
    } else {
      const prev = records[state.month - 1];
      byId('monthExplainer').textContent = `지난달 새끼 ${fmt(prev.babies)}마리가 어른이 되고, 지난달 어른 ${fmt(prev.adults)}마리가 새끼를 한 마리씩 낳았어요.`;
    }
    renderLineage();
    renderTree();
    renderChart();
    renderTable();
  }

  function stop() {
    if (state.timer !== null) clearInterval(state.timer);
    state.timer = null;
    state.playing = false;
    byId('playIcon').textContent = '▶';
    byId('playLabel').textContent = '자동 재생';
  }

  function setMonth(month, fromPlay = false) {
    const next = safeInt(month, 0, LIMIT_MONTH, state.month);
    if (!fromPlay) stop();
    state.month = next;
    render();
    if (fromPlay && state.month === LIMIT_MONTH) stop();
  }

  function setStart() {
    stop();
    if (fields.adults.value.trim() === '' || fields.babies.value.trim() === '') return;
    const adults = safeInt(fields.adults.value, 0, LIMIT_START, state.adults);
    const babies = safeInt(fields.babies.value, 0, LIMIT_START, state.babies);
    if (state.adults !== adults || state.babies !== babies) {
      state.forestPage = 0;
      state.treeView = 'forest';
    }
    state.adults = adults;
    state.babies = babies;
    state.selectedId = null;
    byId('rabbitLookup').value = '';
    render();
  }

  function reset() {
    stop();
    state.adults = 1;
    state.babies = 0;
    state.month = 6;
    state.selectedId = null;
    state.treeView = 'forest';
    state.forestPage = 0;
    state.treeMode = 'adult';
    state.treeFocusId = 1n;
    byId('rabbitLookup').value = '';
    byId('lookupMessage').textContent = '';
    render();
  }

  function lookupRabbit() {
    const raw = byId('rabbitLookup').value.trim().replaceAll(',', '');
    const current = records[state.month];
    if (!/^\d+$/.test(raw)) {
      byId('lookupMessage').textContent = '1 이상의 토끼 번호를 숫자로 입력해 주세요.';
      return;
    }
    const id = BigInt(raw);
    if (id < 1n || id > totalOf(current)) {
      byId('lookupMessage').textContent = `이번 달에는 1번부터 ${fmt(totalOf(current))}번까지의 토끼가 있어요.`;
      return;
    }
    selectRabbit(id);
  }

  fields.adults.addEventListener('input', setStart);
  fields.babies.addEventListener('input', setStart);
  fields.adults.addEventListener('blur', () => { setStart(); fields.adults.value = state.adults; });
  fields.babies.addEventListener('blur', () => { setStart(); fields.babies.value = state.babies; });
  fields.month.addEventListener('input', () => {
    if (fields.month.value.trim() !== '') setMonth(fields.month.value);
  });
  fields.month.addEventListener('blur', () => {
    if (fields.month.value.trim() !== '') setMonth(fields.month.value);
    fields.month.value = state.month;
  });
  fields.month.addEventListener('keydown', e => { if (e.key === 'Enter') { e.target.blur(); } });
  byId('prevMonth').addEventListener('click', () => setMonth(state.month - 1));
  byId('nextMonth').addEventListener('click', () => setMonth(state.month + 1));
  byId('resetBtn').addEventListener('click', reset);
  byId('challengeBtn').addEventListener('click', () => { reset(); byId('initialAdults').focus(); });
  byId('lookupBtn').addEventListener('click', lookupRabbit);
  byId('rabbitLookup').addEventListener('keydown', e => { if (e.key === 'Enter') lookupRabbit(); });
  byId('treeModeAdult').addEventListener('click', () => { state.treeMode = 'adult'; state.treeFocusId = 1n; renderTree(); });
  byId('treeModeBaby').addEventListener('click', () => { state.treeMode = 'baby'; state.treeFocusId = treeSource().adults + 1n; renderTree(); });
  byId('forestModeAll').addEventListener('click', () => { state.treeView = 'forest'; renderTree(); });
  byId('forestModeSingleAdult').addEventListener('click', () => { state.treeView = 'single-adult'; renderTree(); });
  byId('forestModeSingleBaby').addEventListener('click', () => { state.treeView = 'single-baby'; renderTree(); });
  byId('forestModeFocus').addEventListener('click', () => { state.treeView = 'focus'; renderTree(); });
  byId('forestPrev').addEventListener('click', () => { state.forestPage = Math.max(0, state.forestPage - 1); renderTree(); });
  byId('forestNext').addEventListener('click', () => { state.forestPage = Math.min(initialForestPageCount() - 1, state.forestPage + 1); renderTree(); });
  function jumpToInitial(kind) {
    const count = kind === 'adult' ? state.adults : state.babies;
    if (!count) return;
    state.treeView = 'forest';
    if (!visibleInitialRabbits().some(root => root.kind === kind)) state.forestPage = 0;
    renderTree();
    const frame = byId('treeFrame');
    frame.scrollIntoView({ behavior: 'auto', block: 'center', inline: 'nearest' });
    frame.scrollLeft = Math.max(0, (forestOffsets[kind] || 0) - 145);
  }
  byId('forestJumpBaby').addEventListener('click', () => jumpToInitial('baby'));
  byId('forestJumpAdult').addEventListener('click', () => jumpToInitial('adult'));
  for (const button of document.querySelectorAll('[data-tree-depth]')) {
    button.addEventListener('click', () => { state.treeDepth = Number(button.dataset.treeDepth); renderTree(); });
  }
  byId('treeFitBtn').addEventListener('click', () => { state.treeFit = !state.treeFit; renderTree(); });
  byId('treePopupBtn').addEventListener('click', openTreePopup);
  byId('rabbitTree').addEventListener('click', () => { if (!isTreePopup) openTreePopup(); });
  byId('closeTreePopup').addEventListener('click', () => { window.close(); });
  window.addEventListener('resize', renderTree);
  byId('treeFocusPrev').addEventListener('click', () => { state.treeFocusId -= 1n; renderTree(); });
  byId('treeFocusNext').addEventListener('click', () => { state.treeFocusId += 1n; renderTree(); });
  byId('playBtn').addEventListener('click', () => {
    if (state.playing) { stop(); return; }
    if (state.month >= LIMIT_MONTH) setMonth(0);
    state.playing = true;
    byId('playIcon').textContent = 'Ⅱ';
    byId('playLabel').textContent = '일시정지';
    state.timer = setInterval(() => setMonth(state.month + 1, true), 1100);
  });

  byId('downloadBtn').addEventListener('click', () => {
    const rows = ['개월,어른 토끼,새끼 토끼,전체 토끼', ...records.map(r => `${r.month},${r.adults},${r.babies},${r.adults + r.babies}`)];
    const blob = new Blob(['\uFEFF', rows.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `피보나치_토끼_${state.month}개월.csv`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  render();
})();

  </script>
</body>
</html>
