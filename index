/* Individual identities: each rabbit keeps the same ID as it grows. */
.rabbit-token{appearance:none;position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;border:1.5px solid transparent;background:transparent;border-radius:10px;padding:3px 3px 5px;min-width:52px;transition:background .15s,border-color .15s,transform .15s}
.rabbit-token:hover{background:#ffffffa9;transform:translateY(-3px)}
.rabbit-token.is-selected{background:#fff9dc;border-color:#e3b85d;box-shadow:0 0 0 3px #f6d88d5e}
.rabbit-token.is-related{background:#fffaec;border-color:#d2bd87}
.rabbit-id{display:block;max-width:69px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#ffffffb8;border-radius:8px;padding:2px 5px;color:#5b8060;font:900 10px 'DM Sans','Noto Sans KR',sans-serif;letter-spacing:0}
.rabbit-token.baby .rabbit-id{color:#b9786b;background:#fff9f0d9}
.rabbit-more{font-size:11px;max-width:110px;overflow-wrap:anywhere;text-align:center}
.lineage-card{padding:24px 25px 20px}
.lineage-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px}
.lineage-heading h2{margin:0;font-size:20px;font-weight:900;letter-spacing:-.055em;line-height:1.4}
.lineage-heading h2 span{font-size:18px}
.lineage-month{flex:none;background:#edf3e8;border-radius:30px;padding:7px 10px;color:#608269;font:900 12px 'DM Sans','Noto Sans KR',sans-serif;white-space:nowrap}
.lineage-intro{font-size:12px;color:#859589;font-weight:700;line-height:1.65;margin:0 0 17px}
.lineage-search{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:#f7f9f3;border:1px solid #e7ede2;border-radius:12px;padding:10px 12px;margin-bottom:13px}
.lineage-search label{flex:none;font-size:12px;font-weight:900;color:#55745c}
.lineage-search>div{display:flex;gap:7px;min-width:0;flex:1}
.lineage-search input{height:35px;border:1px solid #dfe9dc;border-radius:8px;min-width:0;width:100%;padding:0 11px;background:white;color:#34543f;font:800 13px 'DM Sans','Noto Sans KR',sans-serif;outline:none}
.lineage-search input:focus{border-color:#87ae8c}
.lineage-search button{height:35px;flex:none;border:0;border-radius:8px;background:#577b60;color:white;font-size:11px;font-weight:900;padding:0 10px}
.lineage-search button:hover{background:#3d6649}
.lineage-search button span{margin-left:5px}
.lookup-message{flex-basis:100%;font-size:11px;font-weight:800;color:#ad705d}
.lookup-message:empty{display:none}
.selected-trace{display:flex;gap:10px;align-items:center;border:1px solid #e8eadb;border-radius:12px;background:#f9f8ed;padding:12px 14px;color:#6f8068;font-size:12px;font-weight:800;line-height:1.65;margin-bottom:17px}
.selected-trace .trace-hand{font-size:17px}
.selected-trace.has-selection{display:block;background:#fff8df;border-color:#ead6a4;padding:14px 16px}
.selection-title{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.selection-title strong{color:#3b694d;font-size:15px}
.selection-title .selection-type{padding:3px 8px;background:white;border-radius:6px;color:#a0784b;font-size:10px;font-weight:900}
.selected-trace p{font-size:12px;font-weight:800;line-height:1.7;color:#75694c;margin:3px 0 0}
.trace-columns{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}
.trace-lane{border:1px solid #e4ede0;border-radius:13px;padding:13px 12px;background:#f8fbf6;min-width:0}
.trace-lane.born-lane{background:#fff8f4;border-color:#f3e6de}
.trace-lane-heading{display:flex;align-items:center;gap:8px;margin-bottom:13px}
